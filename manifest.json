{
  "manifest_version": 3,
  "name": "Indelible Verifier",
  "version": "1.0.0",
  "description": "Detect and verify Indelible-attested articles and quotes on any webpage.",

  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "dist/background.js"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Indelible Verifier"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
